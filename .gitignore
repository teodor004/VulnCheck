# Runtime output of the hooks, if this repo ever installs its own checks on itself.
/.hooks/claude-result.json
/.hooks/claude-error.log
/.hooks/osv-results.json
/.hooks/osv-results-maven.json
/.hooks/osv-summary.json
/.hooks/osv-sbom-build.log
/.hooks/osv-results-gradle.json
/.hooks/osv-sbom-gradle.log
/.hooks/security-profile.json

# Maven SBOM output. Regenerated by osv-check.ps1 whenever it is older than a
# pom.xml, so committing it would just be a stale copy of a build artifact.
target/

# Python cache (measurement/harness scripts)
__pycache__/
*.pyc

.DS_Store
.vscode/
.idea/

# Local code-graph / analysis cache
.ua/
